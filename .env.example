# ── Demo / shared-deployment mode ────────────────────────────────────────────
# Set to "true" ONLY on a shared public deployment to enforce BYOK (callers must
# supply their own Anthropic API key) and a 2-audits/day per-IP rate limit.
# Leave unset (or "false") for local dev or self-hosted instances.
DEMO_MODE=false

# ── AI features (optional) ────────────────────────────────────────────────────
# Users can also supply their own key in the browser UI — it is never stored
# on the server. This key is a server-side fallback only.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Analysis thresholds ───────────────────────────────────────────────────────
COMPLEXITY_THRESHOLD=10
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to false in production. Render sets this via the environment variable.
FLASK_DEBUG=true

# ── Feature 1: Async engine (Celery + Redis) ──────────────────────────────────
# Leave blank to use the V1 in-process thread fallback (no Redis required).
# Set to a Redis URL to enable Celery workers and async audit processing.
REDIS_URL=redis://localhost:6379/0

# Optional: separate Redis databases for broker vs result storage.
# Defaults to REDIS_URL if not set.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Audit hard-timeout in seconds (default: 600 = 10 minutes)
AUDIT_TIMEOUT_SECONDS=600

# Maximum repo size to clone in MB (default: 200)
MAX_REPO_SIZE_MB=200
